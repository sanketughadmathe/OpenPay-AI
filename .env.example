OPENPAY_ENV=simulation
OPENPAY_DATABASE_URL=sqlite:///./openpay.db
OPENPAY_LOG_LEVEL=INFO
OPENPAY_MAX_ATTEMPTS=2
OPENPAY_SIM_SEED=42
OPENPAY_GEMINI_API_KEY=API_KEY
# AI copilot (optional). Leave the key empty to use Ollama, or set OPENPAY_LLM_PROVIDER=none for rule-based only.
OPENPAY_LLM_PROVIDER=auto
OPENPAY_GEMINI_API_KEY=
OPENPAY_GEMINI_MODEL=gemini-3.8-flash
